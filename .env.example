# Telegram bot bildirimleri icin (https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alpaca paper trading (ileri asama, trader.py icin - henuz kullanilmiyor)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Finnhub haber API (https://finnhub.io/register)
NEWS_API_KEY=

# Bybit (kripto BTC/ETH futures botu icin, https://www.bybit.com/app/user/api-management)
# Testnet icin ayri bir hesap ve ayri API key gerekir: https://testnet.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

# GUVENLIK: varsayilan testnet'tir (sahte bakiye). Gercek parayla islem
# yapmak icin ASAGIDAKI IKI DEGERI DE bilinçli sekilde degistirmen gerekir:
BYBIT_TESTNET=true
CONFIRM_LIVE_TRADING=false

# Testnet'te otomatik emir varsayilan acik (sahte bakiye, risk yok).
# Sadece bildirim istiyorsan false yap.
CRYPTO_AUTO_TRADE_ENABLED=true
