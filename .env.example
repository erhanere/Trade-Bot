# Telegram bot bildirimleri icin (https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alpaca paper trading (ileri asama, trader.py icin - henuz kullanilmiyor)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Finnhub haber API (https://finnhub.io/register)
NEWS_API_KEY=

# Bybit (kripto futures botu icin, https://www.bybit.com/app/user/api-management)
# Testnet icin ayri bir hesap ve ayri API key gerekir: https://testnet.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Takip edilecek kripto sembolleri (Bybit USDT perpetual futures formati,
# virgulle ayrilmis). Bos birakirsan varsayilan liste kullanilir
# (BTCUSDT, ETHUSDT, MINAUSDT, AVAXUSDT, ENAUSDT, ARBUSDT):
# CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,MINAUSDT,AVAXUSDT,ENAUSDT,ARBUSDT

# GUVENLIK: varsayilan testnet'tir (sahte bakiye). Gercek parayla islem
# yapmak icin ASAGIDAKI IKI DEGERI DE bilinçli sekilde degistirmen gerekir:
BYBIT_TESTNET=true
CONFIRM_LIVE_TRADING=false

# Testnet'te otomatik emir varsayilan acik (sahte bakiye, risk yok).
# Sadece bildirim istiyorsan false yap.
CRYPTO_AUTO_TRADE_ENABLED=true

# Short pozisyon acma - varsayilan kapali (SELL sinyali sadece mevcut long'u
# kapatir). true yaparsan SELL sinyali pozisyon yokken yeni short acar -
# fiyat yukselirse short pozisyon zarar eder / likide olabilir, riski anla.
CRYPTO_ALLOW_SHORT=false

# Risk parametreleri - varsayilanlar (kodun kendi ici) muhafazakardir,
# istersen burada kendi risk toleransina gore degistir:
# CRYPTO_LEVERAGE=3            # kaldirac (yuksek kaldirac = likidasyona daha az mesafe)
# CRYPTO_POSITION_SIZE_PCT=5   # her islemde bakiyenin yuzde kaci kullanilsin
#
# STOP_LOSS/TAKE_PROFIT: coin fiyat yuzdesi DEGIL, pozisyon yuzdesidir
# (kaldiraca gore ROI - Bybit'in "Unrealized P&L(ROI)" sutunuyla ayni sey).
# Orn. CRYPTO_LEVERAGE=20 + CRYPTO_STOP_LOSS_PCT=25 -> pozisyon %25 zararda
# kapanir, bu da fiyatin sadece %1.25 hareket etmesi demektir.
# CRYPTO_STOP_LOSS_PCT=10      # otomatik stop-loss (pozisyon %)
# CRYPTO_TAKE_PROFIT_PCT=20    # otomatik take-profit (pozisyon %)

# Fiyat, destek/dirence bu yuzdenin icine girince sinyal sayilir (varsayilan
# %3). Genis tuttukca tam seviyeye degmeden, yaklasirken sinyal uretir.
# CRYPTO_SR_PROXIMITY_PCT=3

# Her kademe (tranche) CRYPTO_POSITION_SIZE_PCT/CRYPTO_SCALE_IN_TRANCHES
# kadar kucuk acilir (varsayilan 3 -> her kademe hedefin 1/3'u). TOPLAM
# BUYUKLUKTE TAVAN YOK: destek/direnc bolgesine yaklastikca/yakin kaldigi
# surece her yeni sinyalde 2., 3., 4. kademe eklenmeye devam eder - firsat
# oldukca bot pozisyon biriktirir. Tek fren gercek bakiye/marj yetersizligi.
# CRYPTO_SCALE_IN_TRANCHES=3

# Kripto mum araligi (dakika). Varsayilan 15 - 15 dakikalik grafik uzerinde
# RSI/Bollinger/destek-direnc hesaplanir ve islem acilir/kapanir. Bybit'in
# "D"/"W"/"M" gibi degerlerini de kabul eder.
# CRYPTO_KLINE_INTERVAL=15

# Varsayilan (false): BUY/SELL icin RSI'nin de asiri satim/alim esigini
# gecmis olmasi sart - sadece destek/direnc/Bollinger bandina yakinlik
# varsa (RSI notrken) yalnizca bildirim (WATCH) uretilir, islem acilmaz.
# true yaparsan RSI'ye bakilmaksizin sadece bolgeye yakinlik yeter - daha
# sik islem, daha fazla risk (kademeli pozisyon acmayi hizlandirir).
# CRYPTO_REQUIRE_RSI_EXTREME=false
